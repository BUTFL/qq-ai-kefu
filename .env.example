# qq-ai-kefu 配置样例 —— 复制为 .env 后填写。切勿把真实 .env 提交到仓库。
# 必填项标 [必填]，其余可留默认。

# ─────────────────────────── 机器人账号 & 协议端连接 ───────────────────────────
QQ_ACCOUNT=                      # [必填] 机器人 QQ 号（扫码登录的那个号）
# Rosmontis(协议端) 的鉴权 token，随机生成一串即可：openssl rand -hex 24
ROSMONTIS_ACCESS_TOKEN=          # [必填] 协议端 token
# bot 连协议端用的 token，必须与上面 ROSMONTIS_ACCESS_TOKEN 完全一致
ONEBOT_TOKEN=                    # [必填] = ROSMONTIS_ACCESS_TOKEN
VNC_PASSWD=                      # 设密码后可用 noVNC(http://127.0.0.1:6081) 扫码登录

# ─────────────────────────── 大模型（问答 + 向量） ───────────────────────────
LLM_BASE_URL=https://api.example.com/v1   # [必填] OpenAI 兼容网关
LLM_API_KEY=                     # [必填] 模型 API Key
LLM_MODEL=                       # [必填] 主问答模型名
EMBEDDING_MODEL=                 # [必填] 向量模型名（检索用）
# 可选：对话自检/改写用的单独模型（不填则复用上面的）
LLM_CHAT_BASE_URL=
LLM_CHAT_API_KEY=
LLM_CHAT_MODEL=
# 识图 / 预判（可留空用默认）
VISION_MODEL=
VISION_FALLBACK_MODEL=
JUDGE_PREFILTER_MODEL=
JUDGE_PREFILTER_TIMEOUT=8

# ─────────────────────────── 群 & 管理员 ───────────────────────────
ENABLED_GROUPS=                  # [必填] 生效群号，逗号分隔，如 200000001,2000000002
SUPER_ADMINS=                    # [必填] 超管 QQ 号，逗号分隔（接收告警/私聊管理）
REPORT_GROUP=                    # 夜间复盘结果发到的群（可留空）
REPORT_AT=23:00                  # 复盘时间

# ─────────────────────────── 回复行为 ───────────────────────────
DRY_RUN=true                     # true=只记录不真发（首次上线建议 true 观察）
APPROVAL_ANSWER_PREFIX=          # 答案前缀（可留空）
REPLY_SEGMENTS=2                 # 长答案分几段发
REPLY_GAP_MIN=1
REPLY_GAP_MAX=3
KB_REWRITE=false                 # 是否让模型改写标准答案
HANDOFF_ENABLED=true             # 转人工开关
HANDOFF_TEXT=稍等，正在帮您转接人工~

# ─────────────────────────── 控制台 & 局域网 ───────────────────────────
ADMIN_PASSWORD=                  # [必填] 知识库控制台登录密码，留空控制台用不了
WEBUI_TOKEN=                     # 协议端 WebUI token（扫码后台用）
LAN_IP=                          # 局域网访问 IP，如 192.168.1.10（不填=仅本机）

# ─────────────────────────── 容器 ───────────────────────────
NAPCAT_UID=1000                  # 容器内运行 uid
NAPCAT_GID=1000                  # 容器内运行 gid
LOG_LEVEL=INFO

# ─────────────────────────── 可选·远程协助（默认关，不用别填） ───────────────────────────
REMOTE_ENABLED=false
REMOTE_TRANSPORT=
REMOTE_PROFILE=
REMOTE_AUTO_ASSIST=false
REMOTE_AUTO_DRY_RUN=true
REMOTE_AUTO_STEPS=
REMOTE_AUTO_MODEL=
TODESK_MCP_TOKEN=
AWESUN_API_URL=
AWESUN_API_TOKEN=
AWESUN_MCP_URL=
AWESUN_MCP_PORT=
